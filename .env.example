# Copy this file to .env and replace placeholder values locally.
# Never commit real API keys.

# Google Gemini API
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# Optional alternate Gemini key name supported by the AI client
GOOGLE_API_KEY=

# Optional local explanation model settings
LAMINI_MODEL=MBZUAI/LaMini-Flan-T5-783M
EDUGENIE_USE_LOCAL_MODEL=1
