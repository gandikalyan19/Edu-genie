# Copy this file to .env and fill in local values.
# .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# SECRET - the only credential this project needs.
# Get one free at https://aistudio.google.com/app/apikey
# Leave blank to run entirely on local fallback responses.
# Requires: pip install google-generativeai
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Alternate name for the same key. Set either one, not both.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Non-secret configuration. Defaults below work without any changes.
# ---------------------------------------------------------------------------

# Application
APP_NAME=EduGenie Learning Assistant
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database. SQLite by default; swap for PostgreSQL when deploying.
DATABASE_URL=sqlite:///./data/edugenie.db

# Model selection.
# gemini-1.5-pro named in the project document has been retired by Google and
# now returns 404. On a free API key the Pro models allow zero requests and
# gemini-flash-latest allows only 20 per day, so the lite model is the practical
# default. Any failed call degrades to local fallback text, never an error.
GEMINI_MODEL=gemini-flash-lite-latest
LAMINI_MODEL=MBZUAI/LaMini-Flan-T5-783M

# Set to 0 to skip loading LaMini-Flan-T5 (faster startup, uses fallback text).
# Requires: pip install transformers torch
EDUGENIE_USE_LOCAL_MODEL=1
